
name: Build Fling Mobs Addon

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build-addon:
    runs-on: ubuntu-latest

    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Package behavior pack
        run: |
          cd FlingMobs_BP
          zip -r ../FlingMobs_BP.mcpack .

      - name: Package resource pack
        run: |
          cd FlingMobs_RP
          zip -r ../FlingMobs_RP.mcpack .

      - name: Bundle Minecraft addon
        run: |
          zip Fling-Mobs-INSANE.mcaddon \
            FlingMobs_BP.mcpack \
            FlingMobs_RP.mcpack

      - name: Upload addon
        uses: actions/upload-artifact@v4
        with:
          name: Fling-Mobs-INSANE
          path: Fling-Mobs-INSANE.mcaddon
          if-no-files-found: error
          retention-days: 7
